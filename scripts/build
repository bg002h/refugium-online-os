#!/usr/bin/env bash
# Produce a removable-media x86-64 UEFI image without mounting a host device.
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
inputs=$(realpath "${1:-$repo/.work/inputs}")
kernel=$(realpath "${2:-$repo/.work/kernel/arch/x86/boot/bzImage}")
out=$(realpath -m "${3:-$repo/.work/refugium-online-os.img}")
[[ ! -e $out && ! -L $out ]] || { echo 'Choose a new output image.' >&2; exit 2; }
mkdir -p "$(dirname "$out")"
work=$(mktemp -d "$(dirname "$out")/build.XXXXXXXX")
r="$work/root"
mkdir -p "$r"
export LC_ALL=C TZ=UTC SOURCE_DATE_EPOCH=1795046400
(cd "$inputs" && sha256sum --quiet -c <(grep -v ' linux-' "$repo/image/inputs.sha256"))
(cd "$inputs/debs" && sha256sum --quiet -c "$repo/image/packages.sha256")
tar --no-same-owner -xf "$inputs/ubuntu-base-24.04.5-base-amd64.tar.gz" -C "$r"
# Extract precisely the locked set without executing package services.
while read -r digest name; do
    member=$(ar t "$inputs/debs/$name" | grep -E '^data\.tar(\.|$)')
    case "$member" in
        *.zst) decoder=zstd ;;
        *.xz) decoder=xz ;;
        *.gz) decoder=gzip ;;
        *) echo "Unsupported package archive $member" >&2; exit 1 ;;
    esac
    ar p "$inputs/debs/$name" "$member" | "$decoder" -dc | tar --keep-directory-symlink --no-same-owner -x -C "$r"
done < "$repo/image/packages.sha256"
mkdir -p "$r"/{data,run,tmp,etc/refugium-online,usr/local/bin,usr/lib/refugium-online,etc/ssl/certs}
tar -xf "$inputs/bitcoin-31.1-x86_64-linux-gnu.tar.gz" -C "$r/usr/local/bin" --strip-components=2 bitcoin-31.1/bin/bitcoind bitcoin-31.1/bin/bitcoin-cli
install -m0755 "$repo/image/init" "$r/init"
install -m0644 "$repo"/image/app/*.py "$r/usr/lib/refugium-online/"
install -m0644 "$repo"/image/{torrc,bitcoin.conf,peers} "$r/etc/refugium-online/"
cat "$r"/usr/share/ca-certificates/mozilla/*.crt > "$r/etc/ssl/certs/ca-certificates.crt"
for entry in tor:910 peers:911 bitcoin:912 explorer:913 operator:914; do
    name=ro-${entry%:*}; id=${entry#*:}
    echo "$name:x:$id:$id:Refugium service:/:/usr/sbin/nologin" >> "$r/etc/passwd"
    echo "$name:x:$id:" >> "$r/etc/group"
done
printf '%s\n' 'NAME="Refugium Online OS"' 'ID=refugium-online-os' 'ID_LIKE=ubuntu' 'PRETTY_NAME="Refugium Online OS (signet)"' > "$r/etc/os-release.new"
mv -T "$r/etc/os-release.new" "$r/etc/os-release"
for essential in bin/sh usr/bin/python3 usr/bin/tor usr/sbin/nft usr/sbin/ip lib64/ld-linux-x86-64.so.2; do
    test -x "$r/$essential" || { echo "Missing guest executable $essential" >&2; exit 1; }
done
esp="$work/esp"
mkdir -p "$esp"/{EFI/BOOT,loader/entries,refugium}
cp "$r/usr/lib/systemd/boot/efi/systemd-bootx64.efi" "$esp/EFI/BOOT/BOOTX64.EFI"
cp "$kernel" "$esp/refugium/linux.efi"
echo 'default refugium.conf' > "$esp/loader/loader.conf"
echo 'timeout 0' >> "$esp/loader/loader.conf"
echo 'editor no' >> "$esp/loader/loader.conf"
cat > "$esp/loader/entries/refugium.conf" <<'EOF'
title Refugium Online OS
linux /refugium/linux.efi
initrd /refugium/root.gz
options rdinit=/init ro quiet panic=-1 console=tty0 console=ttyS0,115200n8 net.ifnames=0
EOF
find "$r" -exec touch -h -d '@1795046400' {} +
(cd "$r" && find . -mindepth 1 -printf '%P\0' | sort -z | cpio --null --quiet --reproducible --owner=0:0 -o -H newc | gzip -1n) > "$esp/refugium/root.gz"
find "$esp" -exec touch -h -d '@1795046400' {} +
mib=$(( $(du -sb "$esp" | cut -f1) / 1048576 + 24 ))
truncate -s "${mib}M" "$work/efi.fat"
mkfs.fat --invariant -F32 -n R_ONLINE "$work/efi.fat" >/dev/null
mcopy -spm -i "$work/efi.fat" "$esp/EFI" "$esp/loader" "$esp/refugium" ::/
python3 "$repo/scripts/gpt.py" "$work/efi.fat" "$out"
sha256sum "$out"
