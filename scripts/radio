#!/usr/bin/env python3
"""Forward the operator's local demodulated Blockstream UDP stream into the VM."""
import argparse
import os
from pathlib import Path
import socket
import stat
import struct

p = argparse.ArgumentParser(description=__doc__)
p.add_argument('state', type=Path)
p.add_argument('--interface', required=True, help='IPv4 address of the local receiver interface')
p.add_argument('--source', help='accept datagrams only from this receiver source IP')
args = p.parse_args()
interface = socket.inet_aton(args.interface)
group = '239.0.0.2'
with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as udp:
    udp.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    udp.setsockopt(socket.IPPROTO_IP, 49, 0)  # Linux IP_MULTICAST_ALL
    udp.bind((group, 4434))
    udp.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP, socket.inet_aton(group) + interface)
    fd = os.open(args.state/'radio.in', os.O_WRONLY | os.O_NOFOLLOW)
    if not stat.S_ISFIFO(os.fstat(fd).st_mode):
        raise ValueError('Expected the VM radio FIFO')
    while True:
        data, sender = udp.recvfrom(65535)
        if 0 < len(data) <= 2048 and (args.source is None or sender[0] == args.source):
            os.write(fd, struct.pack('!H', len(data))+data)
