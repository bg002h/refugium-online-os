#!/bin/sh
set -eu
apps=/opt/refugium-desktop
case "$1" in
    status)
        exec xterm -name refugium-status -title 'Refugium | Node status' \
            -xrm "XTerm*iconHint: $apps/icons/status.xpm" -fa 'DejaVu Sans Mono' -fs 12 \
            -bg '#101923' -fg '#e6ebef' -geometry 82x26+28+22 \
            -e /usr/bin/python3 -B /usr/lib/refugium-online/console.py --screen
        ;;
    terminal)
        cd "$HOME"
        export SHELL=/bin/bash
        exec xterm -name refugium-terminal -title 'Terminal' -fa 'DejaVu Sans Mono' -fs 12 \
            -xrm "XTerm*iconHint: $apps/icons/refugium-terminal.xpm" \
            -xrm 'XTerm*VT100.Translations: #override \n Ctrl Shift <Key>C: copy-selection(CLIPBOARD) \n Ctrl Shift <Key>V: insert-selection(CLIPBOARD)' \
            -bg '#101923' -fg '#e6ebef' -geometry 90x28 -e "$SHELL" -i
        ;;
    esplora) exec "$apps/firefox/firefox" --new-window http://127.0.0.1:8080/ ;;
    mempool) exec "$apps/firefox/firefox" --new-window http://127.0.0.1:8081/ ;;
    # QEMU scales the entire guest. Let the wallet lay out in guest pixels.
    wallet) export WINIT_X11_SCALE_FACTOR=1 SLINT_SCALE_FACTOR=1; exec "$apps/bin/mr-gui" ;;
    pubkeys) exec mousepad "$HOME/pubkeys" ;;
    *) exit 2 ;;
esac
